{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "maggia-crm",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maggia-crm",
      "database_id": "cbbc6cb1-a874-4e41-898f-7a11c7211476",
      "migrations_dir": "./migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["0 13 * * *"]
  },
  "vars": {
    "APP_NAME": "MaggIA CRM",
    "PUBLIC_LANDING_ORIGIN": "https://maggiesalmeron.com",
    "OPENAI_MODEL": "gpt-5.6-luna"
  }
}
